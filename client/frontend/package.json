{
  "name": "scrimgg",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@mui/icons-material": "^5.15.14",
    "@mui/material": "^5.15.14",
    "@mui/x-charts": "^7.1.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.6.8",
    "electron": "^29.1.6",
    "electron-builder": "^24.13.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.7.5",
    "web-vitals": "^2.1.4"
  },
  "main": "main.js",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "react-test": "react-scripts test",
    "react-eject": "react-scripts eject",
    "electron-start": "electron main.js",
    "start": "concurrently \"npm run react-start\" \"npm run electron-start\"",
    "start:dev": "cross-env NODE_ENV=development concurrently \"npm run react-start\" \"npm run electron-start\"",
    "start:prod": "cross-env NODE_ENV=production concurrently \"npm run react-start\" \"npm run electron-start\""
  },
  "devDependencies": {
    "concurrently": "^5.3.0",
    "cross-env": "^10.1.0",
    "electron": "^11.0.0",
    "electron-builder": "^22.9.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.scrimgg.client",
    "productName": "Scrim.GG",
    "files": [
      "build/**/*",
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/*.pyc",
          "!**/__pycache__",
          "!**/Pipfile.lock"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    }
  }
}
