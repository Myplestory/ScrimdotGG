# Scrim.GG - Git Ignore File
# This file tells Git which files/folders to ignore

# ============================================================
# Python (Backend)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Pipenv
Pipfile.lock

# Virtual environments
venv/
ENV/
env/
.venv

# ============================================================
# Node.js / React / Electron (Frontend)
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Testing
coverage/
*.lcov
.nyc_output

# Production builds
build/
dist/
out/

# Dependencies
package-lock.json
yarn.lock

# ============================================================
# Environment & Config
# ============================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Sensitive data
*/data/data.json
config/secrets.json
*.key
*.pem
*.cert

# ============================================================
# IDEs and Editors
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================
# Logs
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# OS Files
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================================
# Electron
# ============================================================
dist-electron/
release/
*.dmg
*.zip
*.exe
*.msi

# ============================================================
# Documentation & Examples (Keep These)
# ============================================================
# We want to keep these files in the repo
!examples/*.py
!examples/*.jsx
!examples/*.js
!*.md
!ARCHITECTURE_IMPROVEMENTS.md
!IMPLEMENTATION_ROADMAP.md
!WEBSOCKET_REFACTOR_SUMMARY.md
!QUICK_START.md
!REFACTOR_COMPLETE.md

# ============================================================
# Misc
# ============================================================
.cache/
.temp/
tmp/
temp/
*.tmp
*.bak
*.swp

